# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nazra
TEST_MONGO_URI=mongodb://127.0.0.1:27017/nazra_test

# Authentication - replace every placeholder with an independent random value
JWT_SECRET=<replace-with-random-secret>
PASSWORD_RESET_CODE_PEPPER=<replace-with-random-secret>
AUTH_RATE_LIMIT_PEPPER=<replace-with-random-secret>
BCRYPT_ROUNDS=12

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=<smtp-username>
EMAIL_PASS=<smtp-app-password>
EMAIL_FROM="NAZRA <no-reply@example.com>"
ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=contact@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
