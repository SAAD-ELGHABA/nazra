# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000

# Canonical public origin used to build absolute sitemap URLs.
# Leave unset in production: it already defaults to https://nazra.store.
# Set it on preview deployments so they never advertise production URLs.
PUBLIC_SITE_URL=http://localhost:5173

# Delivery pricing. Flat nationwide fee in MAD, decided server-side and
# snapshotted onto each order. Unset means free delivery — set the real courier
# price before taking orders. DELIVERY_FREE_THRESHOLD_MAD=0 disables the
# free-above-threshold rule.
DELIVERY_FEE_MAD=0
DELIVERY_FREE_THRESHOLD_MAD=0

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/nazra
TEST_MONGO_URI=mongodb://127.0.0.1:27017/nazra_test

# Authentication - replace every placeholder with an independent random value
JWT_SECRET=<replace-with-random-secret>
PASSWORD_RESET_CODE_PEPPER=<replace-with-random-secret>
# Signs the review invitation links emailed on delivery. Optional — falls back
# to JWT_SECRET, but set it independently so rotating one does not invalidate
# every outstanding review link.
REVIEW_TOKEN_PEPPER=<replace-with-random-secret>
AUTH_RATE_LIMIT_PEPPER=<replace-with-random-secret>
BCRYPT_ROUNDS=12

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-app-password>
# Legacy aliases also supported: EMAIL_USER and EMAIL_PASS
EMAIL_FROM="NAZRA <no-reply@example.com>"
ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=contact@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_UPLOAD_PRESET=<signed-upload-preset>
