VITE_API_URL=http://localhost:5000/api

# Delivery fee shown in the cart and checkout summary. DISPLAY ONLY — the
# server recalculates it and is the authority. Keep in step with the backend's
# DELIVERY_FEE_MAD / DELIVERY_FREE_THRESHOLD_MAD. Unset means free delivery.
VITE_DELIVERY_FEE_MAD=0
VITE_DELIVERY_FREE_THRESHOLD_MAD=0

# Server-side only (never exposed to the browser bundle): origin the
# /sitemap.xml function proxies. Optional — it falls back to VITE_API_URL.
SITEMAP_API_URL=http://localhost:5000/api

# Measurement tags. Each loads only when its ID is set AND the visitor has
# granted the matching cookie category (analytics for GA4, marketing for the
# ad pixels). Leave blank and nothing is ever loaded.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
